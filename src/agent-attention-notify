#!/usr/bin/env bash
set -euo pipefail

harness=${1:?harness required}
event=${2:?event required}
pid=${3:?agent process PID required}
[[ $pid =~ ^[0-9]+$ ]] || exit 2
data_home=${XDG_DATA_HOME:-"$HOME/.local/share"}
window_helper="$HOME/.local/bin/agent-attention-window"

case "$event" in
  needs_input|approval)
    urgency=critical
    title="$harness needs your input"
    body="An approval or question is waiting for your response."
    ;;
  finished)
    urgency=normal
    title="$harness finished"
    body="The session is waiting for your next instruction."
    ;;
  *) exit 2 ;;
esac

case "${harness,,}" in
  codex) icon="$data_home/agent-attention/icons/codex.png" ;;
  opencode) icon="$data_home/agent-attention/icons/opencode.svg" ;;
  *) icon= ;;
esac

if "$window_helper" visible "$pid" 2>/dev/null; then
  exit 0
fi

if [[ -n $icon && -r $icon ]]; then
  exec omarchy-notification-send --app-name "$harness" -u "$urgency" --image "$icon" "$title" "$body" --exec "$window_helper" focus "$pid"
fi
exec omarchy-notification-send --app-name "$harness" -u "$urgency" "$title" "$body" --exec "$window_helper" focus "$pid"
